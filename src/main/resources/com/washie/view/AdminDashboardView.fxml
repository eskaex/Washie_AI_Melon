<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.washie.controller.AdminDashboardController"
      stylesheets="@/css/styles.css"
      prefWidth="1100" prefHeight="750">

    <!-- SIDEBAR -->
    <VBox styleClass="sidebar" prefWidth="280" spacing="0">
        <HBox styleClass="sidebar-header" spacing="10" alignment="CENTER_LEFT">
            <Label styleClass="sidebar-avatar-admin" text="A"/>
            <Label fx:id="lblAdminName" styleClass="sidebar-username" text="Admin"/>
        </HBox>
        <Separator/>
        <VBox styleClass="sidebar-menu" spacing="4">
            <Label text="Kelola Data" styleClass="sidebar-section-label"/>
            <Button text="Dashboard" styleClass="sidebar-menu-btn sidebar-active"
                    maxWidth="Infinity"/>
            <Button text="Kelola Layanan" styleClass="sidebar-menu-btn"
                    maxWidth="Infinity" onAction="#handleGoLayanan"/>
            <Button text="Info Laundry" styleClass="sidebar-menu-btn"
                    maxWidth="Infinity" onAction="#handleGoInfo"/>
        </VBox>
        <Region VBox.vgrow="ALWAYS"/>
        <Button text="← Keluar" styleClass="btn-keluar" maxWidth="Infinity" prefHeight="46" onAction="#handleKeluar"/>
    </VBox>

    <!-- CONTENT -->
    <VBox HBox.hgrow="ALWAYS" styleClass="admin-content" spacing="20">
        <!-- Top bar -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label text="Dashboard Admin" styleClass="admin-page-title" HBox.hgrow="ALWAYS"/>
            <TextField fx:id="tfCari" styleClass="field-input" promptText="Cari Pesanan"
                       prefWidth="260" onAction="#handleCari"/>
            <Button text="🔍" styleClass="btn-icon" onAction="#handleCari"/>
        </HBox>

        <!-- Stats cards -->
        <HBox spacing="16">
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="4">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="" styleClass="stat-icon"/>
                    <VBox>
                        <Label fx:id="lblDiproses" text="0" styleClass="stat-number"/>
                        <Label text="Sedang Diproses" styleClass="stat-label"/>
                    </VBox>
                </HBox>
            </VBox>
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="4">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="" styleClass="stat-icon"/>
                    <VBox>
                        <Label fx:id="lblAktif" text="0" styleClass="stat-number"/>
                        <Label text="Pesanan Aktif" styleClass="stat-label"/>
                    </VBox>
                </HBox>
            </VBox>
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="4">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="" styleClass="stat-icon"/>
                    <VBox>
                        <Label fx:id="lblDiambil" text="0" styleClass="stat-number"/>
                        <Label text="Sudah Diambil" styleClass="stat-label"/>
                    </VBox>
                </HBox>
            </VBox>
        </HBox>

        <!-- Table -->
        <VBox styleClass="table-card" VBox.vgrow="ALWAYS" spacing="10">
            <Label text="Daftar Pesanan Terkini" styleClass="table-card-title"/>
            <TableView fx:id="tablePesanan" VBox.vgrow="ALWAYS" styleClass="washie-table">
                <columns>
                    <TableColumn fx:id="colId" text="ID PESANAN" prefWidth="120"/>
                    <TableColumn fx:id="colPengguna" text="PENGGUNA" prefWidth="150"/>
                    <TableColumn fx:id="colLayanan" text="LAYANAN" prefWidth="160"/>
                    <TableColumn fx:id="colTanggal" text="TGL MASUK" prefWidth="120"/>
                    <TableColumn fx:id="colStatus" text="STATUS" prefWidth="110"/>
                    <TableColumn fx:id="colAksi" text="AKSI" prefWidth="80"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</HBox>
