<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.washie.controller.KelolaLayananController"
      stylesheets="@/css/styles.css"
      prefWidth="1100" prefHeight="750">

    <!-- SIDEBAR -->
    <VBox styleClass="sidebar" prefWidth="280" spacing="0">
        <HBox styleClass="sidebar-header" spacing="10" alignment="CENTER_LEFT">
            <Label styleClass="sidebar-avatar-admin" text="A"/>
            <Label fx:id="lblAdminName" styleClass="sidebar-username" text="Admin"/>
        </HBox>
        <Separator/>
        <VBox styleClass="sidebar-menu" spacing="4">
            <Label text="Kelola Data" styleClass="sidebar-section-label"/>
            <Button text="Dashboard" styleClass="sidebar-menu-btn"
                    maxWidth="Infinity" onAction="#handleGoDashboard"/>
            <Button text="Kelola Layanan" styleClass="sidebar-menu-btn sidebar-active"
                    maxWidth="Infinity"/>
            <Button text="Info Laundry" styleClass="sidebar-menu-btn"
                    maxWidth="Infinity" onAction="#handleGoInfo"/>
        </VBox>
        <Region VBox.vgrow="ALWAYS"/>
        <Button text="← Keluar" styleClass="btn-keluar" maxWidth="Infinity" prefHeight="46" onAction="#handleKeluar"/>
    </VBox>

    <!-- CONTENT -->
    <VBox HBox.hgrow="ALWAYS" styleClass="admin-content" spacing="16">
        <HBox alignment="CENTER_LEFT">
            <Label text="Kelola Layanan" styleClass="admin-page-title" HBox.hgrow="ALWAYS"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="+ Tambah Layanan" styleClass="btn-primary-sm" onAction="#handleTambah"/>
        </HBox>

        <!-- Filter bar -->
        <HBox spacing="12" alignment="CENTER_LEFT">
            <TextField fx:id="tfCari" styleClass="field-input" promptText="Cari Layanan"
                       prefWidth="360" HBox.hgrow="ALWAYS"/>
            <Button text="🔍" styleClass="btn-icon"/>
            <ComboBox fx:id="cbFilter" styleClass="field-input" prefWidth="160"/>
        </HBox>

        <!-- Table -->
        <VBox styleClass="table-card" VBox.vgrow="ALWAYS" spacing="10">
            <HBox alignment="CENTER_LEFT">
                <Label text="Daftar Layanan" styleClass="table-card-title" HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblJumlah" text="0 Layanan" styleClass="badge-count"/>
            </HBox>
            <TableView fx:id="tableLayanan" VBox.vgrow="ALWAYS" styleClass="washie-table">
                <columns>
                    <TableColumn fx:id="colNama"     text="Nama Layanan"    prefWidth="200"/>
                    <TableColumn fx:id="colHarga"    text="Harga"           prefWidth="130"/>
                    <TableColumn fx:id="colEstimasi" text="Estimasi Waktu"  prefWidth="160"/>
                    <TableColumn fx:id="colStatus"   text="STATUS"          prefWidth="100"/>
                    <TableColumn fx:id="colAksi"     text="AKSI"            prefWidth="140"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</HBox>
