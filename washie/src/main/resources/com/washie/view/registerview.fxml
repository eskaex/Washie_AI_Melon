<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.washie.controller.RegisterController"
      stylesheets="@/css/styles.css"
      prefWidth="1100" prefHeight="750">

    <!-- LEFT PANEL -->
    <VBox styleClass="left-panel" prefWidth="500" alignment="CENTER" spacing="20">
        <Label styleClass="logo-text" text="washie"/>
        <Label styleClass="left-tagline" text="Pembuatan akun" wrapText="true" alignment="CENTER" maxWidth="340"/>
        <Label styleClass="left-sub" text="Daftarkan akun kamu untuk mulai menggunakan chatbot Washie!"
               wrapText="true" alignment="CENTER" maxWidth="320"/>
    </VBox>

    <!-- RIGHT PANEL -->
    <VBox styleClass="right-panel" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="0">
        <VBox maxWidth="420" spacing="10" alignment="CENTER_LEFT">
            <Label styleClass="form-title" text="Buat Akun Baru"/>
            <Label styleClass="form-sub" text="Lengkapi data di bawah ini untuk mendaftar."/>

            <Region prefHeight="16"/>

            <Label styleClass="field-label" text="NAMA LENGKAP"/>
            <TextField fx:id="tfNama" styleClass="field-input" promptText="Masukkan nama lengkap" maxWidth="420"/>

            <Region prefHeight="6"/>

            <HBox spacing="12" maxWidth="420">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label styleClass="field-label" text="NO. TELEPON"/>
                    <TextField fx:id="tfNoTelp" styleClass="field-input" promptText="08xx-xxxx-xxxx"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label styleClass="field-label" text="PASSWORD"/>
                    <StackPane>
                        <PasswordField fx:id="pfPassword" styleClass="field-input" promptText="Min. 6 karakter"/>
                        <TextField fx:id="tfPasswordVisible" styleClass="field-input" promptText="Min. 6 karakter"/>
                        <Button fx:id="btnTogglePass" text="🙈" styleClass="btn-toggle-pass"
                                onAction="#handleTogglePass" StackPane.alignment="CENTER_RIGHT"/>
                    </StackPane>
                </VBox>
            </HBox>

            <Region prefHeight="6"/>

            <Label styleClass="field-label" text="KONFIRMASI PASSWORD"/>
            <StackPane maxWidth="420">
                <PasswordField fx:id="pfKonfirmasi" styleClass="field-input" promptText="Ulangi password"/>
                <TextField fx:id="tfKonfirmasiVisible" styleClass="field-input" promptText="Ulangi password"/>
                <Button fx:id="btnToggleKonfirmasi" text="🙈" styleClass="btn-toggle-pass"
                        onAction="#handleToggleKonfirmasi" StackPane.alignment="CENTER_RIGHT"/>
            </StackPane>

            <Region prefHeight="4"/>
            <Label fx:id="lblError" styleClass="label-error" text="" wrapText="true" maxWidth="420"/>
            <Label fx:id="lblSuccess" styleClass="label-success" text="" wrapText="true" maxWidth="420"/>
            <Region prefHeight="8"/>

            <Button text="Daftar" styleClass="btn-primary" maxWidth="420" prefHeight="46" onAction="#handleDaftar"/>

            <HBox alignment="CENTER" spacing="4" maxWidth="420">
                <Label text="Sudah punya akun?" styleClass="form-sub"/>
                <Hyperlink fx:id="hlLogin" text="Masuk di sini" styleClass="link-action" onAction="#handleGoLogin"/>
            </HBox>
        </VBox>
    </VBox>
</HBox>
